# --- Base de données (Neon) ---
# Sur Vercel, l'intégration Neon préfixe les variables avec VIDVERSAL_
# (VIDVERSAL_DATABASE_URL / VIDVERSAL_DATABASE_URL_UNPOOLED) — le code les lit.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Authentification (Auth.js) ---
# Générer avec : npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Emails ayant le rôle admin, séparés par des virgules
ADMIN_EMAILS=

# Google OAuth (Google Cloud Console) — vide = bouton Google masqué
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false

# --- Envoi d'emails (Gmail SMTP / mot de passe d'application) ---
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Vidversal <votre.email@gmail.com>
# Recevoir les messages du formulaire de contact (vide = EMAIL_USER)
CONTACT_EMAIL=

# --- Admin du site (/admin) ---
# Mot de passe propriétaire de la page d'administration
ADMIN_PASSWORD=

# --- Paiement Stripe (optionnel, à brancher plus tard) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URL de base du worker de téléchargement (Railway/Render/Fly.io).
# Laisse vide pour utiliser les routes /api locales.
NEXT_PUBLIC_DOWNLOAD_API_URL=
# "true" pour activer l'UI de téléchargement, "false" pour afficher "bientôt disponible"
NEXT_PUBLIC_ENABLE_DOWNLOAD=true

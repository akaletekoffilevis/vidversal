NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mot de passe de l'administrateur (page /admin)
ADMIN_PASSWORD=

# URL de base du worker de téléchargement (Railway/Render/Fly.io).
# Laisse vide pour utiliser les routes /api locales.
NEXT_PUBLIC_DOWNLOAD_API_URL=
# "true" pour activer l'UI de téléchargement, "false" pour afficher "bientôt disponible"
NEXT_PUBLIC_ENABLE_DOWNLOAD=true
